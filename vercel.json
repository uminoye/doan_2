{
  "projects": [
    {
      "path": "frontend",
      "settings": {
        "framework": "vite",
        "buildCommand": "npm install --legacy-peer-deps && ESLINT_NO_DEV_ERRORS=true npm run build",
        "outputDirectory": "dist",
        "installCommand": "npm install --legacy-peer-deps",
        "devCommand": "npm run dev",
        "env": {
          "VITE_API_URL": "@api-url"
        }
      }
    }
  ]
}
